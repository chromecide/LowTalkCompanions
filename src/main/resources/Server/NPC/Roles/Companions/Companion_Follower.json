{
  "$Comment": "The role a companion takes while travelling with a player. Flock membership drives the state: a follower seeks the flock leader (the player); an NPC in no flock waits and watches. The appearance is kept from the NPC's original role when Companions swaps roles.",
  "Type": "Generic",
  "StartState": "Follow",
  "Appearance": "Kweebec_Sapling_Treesinger",
  "MaxHealth": 100,
  "IsMemory": false,
  "Invulnerable": false,
  "KnockbackScale": 1,
  "DefaultNPCAttitude": "Ignore",
  "DefaultPlayerAttitude": "Friendly",
  "FlockAllowedNPC": [
    "Companion_Follower"
  ],
  "FlockCanLead": false,
  "NameTranslationKey": "server.npcRoles.Companion_Follower.name",
  "MotionControllerList": [
    {
      "Type": "Walk",
      "MaxWalkSpeed": 8,
      "RunThreshold": 0.6,
      "Gravity": 10,
      "MaxFallSpeed": 15,
      "MaxRotationSpeed": 360,
      "Acceleration": 10,
      "MaxClimbHeight": 1.5,
      "MaxDropHeight": 5
    }
  ],
  "Instructions": [
    {
      "Sensor": {
        "Type": "State",
        "State": "Follow"
      },
      "Instructions": [
        {
          "$Comment": "Told to stay, or the player is gone: left the flock, so wait.",
          "Sensor": {
            "Type": "Self",
            "Filters": [
              {
                "Type": "Flock",
                "FlockStatus": "NotMember"
              }
            ]
          },
          "Actions": [
            {
              "Type": "State",
              "State": "Wait"
            }
          ]
        },
        {
          "$Comment": "Walk after the flock leader, slowing down close to them; look at them while doing it.",
          "Sensor": {
            "Type": "FlockLeader"
          },
          "HeadMotion": {
            "Type": "Watch"
          },
          "BodyMotion": {
            "Type": "Seek",
            "SlowDownDistance": 6,
            "StopDistance": 3,
            "AbortDistance": 200
          }
        },
        {
          "Sensor": {
            "Type": "Any"
          },
          "BodyMotion": {
            "Type": "Nothing"
          }
        }
      ]
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "Wait"
      },
      "Instructions": [
        {
          "$Comment": "Back in the player's flock: follow again.",
          "Sensor": {
            "Type": "Self",
            "Filters": [
              {
                "Type": "Flock",
                "FlockStatus": "Follower"
              }
            ]
          },
          "Actions": [
            {
              "Type": "State",
              "State": "Follow"
            }
          ]
        },
        {
          "Continue": true,
          "Sensor": {
            "Type": "Player",
            "Range": 12
          },
          "HeadMotion": {
            "Type": "Watch"
          }
        },
        {
          "Sensor": {
            "Type": "Any"
          },
          "BodyMotion": {
            "Type": "Nothing"
          }
        }
      ]
    }
  ],
  "InteractionInstruction": {
    "Instructions": [
      {
        "Sensor": {
          "Type": "Not",
          "Sensor": {
            "Type": "CanInteract",
            "ViewSector": 360
          }
        },
        "Actions": [
          {
            "Type": "SetInteractable",
            "Interactable": false
          }
        ]
      },
      {
        "Continue": true,
        "Sensor": {
          "Type": "Any"
        },
        "Actions": [
          {
            "Type": "SetInteractable",
            "Interactable": true,
            "Hint": "server.companions.hint.talk"
          }
        ]
      },
      {
        "Sensor": {
          "Type": "HasInteracted"
        },
        "Actions": [
          {
            "Type": "LowTalkOpenDialogue"
          }
        ]
      }
    ]
  }
}
